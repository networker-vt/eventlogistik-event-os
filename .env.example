# =============================================================================
# LoadIn Event-OS — Environment (Production Upload)
# Kopiere nach .env / .env.local. NIEMALS echte Keys committen.
# Service-Role-Key gehört NUR auf den Server — nie ins Frontend / VITE_*.
# =============================================================================

# --- Supabase (optional) ---
# Wenn URL + Anon-Key gültig gesetzt sind, bevorzugt die App Supabase
# (Hydrate + Write-Through). Sonst: localStorage-Demo mit Seed-Daten.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# true = erzwingt Demo-Hinweise in Doku; Store fällt ohnehin ohne Keys zurück
VITE_USE_MOCK=true

# --- App ---
VITE_APP_NAME=LoadIn
# Öffentliche Basis-URL (Pages oder Custom Domain) — für Docs / spätere Deep Links
VITE_APP_URL=https://networker-vt.github.io/eventlogistik-event-os/

# Optional später:
# VITE_PLAUSIBLE_DOMAIN=
# VITE_SENTRY_DSN=

# --- Payments (MOCK ONLY) ---
# Wallet / Pay-Sheet sind reine UI-Stubs. Die App ruft KEINE PayPal-, Stripe-
# oder Krypto-APIs auf. Keys hier zu setzen ändert nichts — kein echtes Geld.
# VITE_PAYPAL_CLIENT_ID=
# VITE_STRIPE_PUBLISHABLE_KEY=
